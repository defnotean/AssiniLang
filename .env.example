# AssiniLang local configuration template.
# Copy to .env for local development. Keep real secrets in .env only.

# Deterministic / no-model mode. This is the safest default and makes no model calls.
ASSINI_LLM_PROVIDER=deterministic

# Local OpenAI-compatible model mode. Uncomment and fill these when using Ollama,
# LM Studio, llama.cpp, or another local compatible server.
# ASSINI_LLM_PROVIDER=ollama
# ASSINI_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ASSINI_LLM_MODEL=llama3.1
# ASSINI_LLM_API_KEY=
# ASSINI_LLM_TIMEOUT_MS=30000
# ASSINI_LLM_MAX_TOKENS=4096
# ASSINI_LLM_JSON_MODE=
# ASSINI_LLM_DISCOVERY_BASE_URLS=

# Remote LAN model (e.g. DGX Spark via NVIDIA Sync). Use lm-studio for LM Studio /
# llama.cpp OpenAI-compatible servers. Large models may need a higher timeout.
# ASSINI_LLM_PROVIDER=lm-studio
# ASSINI_LLM_BASE_URL=http://gx10-db18.local:1234/v1
# ASSINI_LLM_MODEL=<full model id from GET /v1/models>
# ASSINI_LLM_TIMEOUT_MS=300000
# ASSINI_LLM_DISCOVERY_BASE_URLS=http://gx10-db18.local:1234/v1

# Audio transcription endpoint. Leave unset unless you run a local Whisper-compatible server.
ASSINI_TRANSCRIBE_BASE_URL=
ASSINI_TRANSCRIBE_MODEL=whisper-1
ASSINI_TRANSCRIBE_API_KEY=

# Ingestion safety and OCR.
ASSINI_ALLOW_PRIVATE_URLS=
ASSINI_OCR_LANG=eng

# Local dev ports and persistence.
ASSINI_DEV_API_PORT=4321
ASSINI_DEV_WEB_PORT=5173
ASSINI_DB_PATH=data/local-db.json

# API runtime envelope. Keep origins comma-separated when exposing the API to a deployed web app.
ASSINI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSINI_BODY_LIMIT_BYTES=65536
ASSINI_API_LOGGER=

# Prototype browser sessions are for local development only.
ASSINI_ENABLE_PROTOTYPE_AUTH=
# Server token for gated API routes (Model Setup, health-check, settings). Match in x-assini-dev-token.
# ASSINI_DEV_AUTH_TOKEN=
