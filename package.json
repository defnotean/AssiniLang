{
  "name": "assini-lang",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run check && npm run build --workspaces --if-present",
    "check": "tsc -b packages/db packages/eval apps/api apps/web",
    "test": "vitest run --passWithNoTests",
    "seed": "npm --workspace @assini/db run seed",
    "db:backup": "npm --workspace @assini/db run db:backup",
    "eval": "npm --workspace @assini/eval run eval",
    "model:verify": "node scripts/verifyLocalModelLanguage.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:beta": "node scripts/verifyBetaCli.mjs",
    "ci:green": "node scripts/ciGreenSmoke.mjs",
    "smoke": "tsx scripts/smokeIngestion.mjs",
    "smoke:backup": "tsx scripts/smokeBackupRestore.mjs",
    "desktop": "node scripts/startDesktop.mjs",
    "desktop:package": "npm run build && node scripts/packageDesktop.mjs",
    "desktop:smoke": "node scripts/smokeDesktopPackage.mjs",
    "desktop:package:smoke": "npm run desktop:package && npm run desktop:smoke",
    "desktop:package:smoke:built": "node scripts/packageDesktop.mjs && npm run desktop:smoke",
    "smoke:web": "electron scripts/smokeWeb.cjs",
    "smoke:web:linux-ci": "electron --no-sandbox scripts/smokeWeb.cjs",
    "dev": "node scripts/dev.mjs",
    "demo": "npm run seed && npm run eval && npm run dev"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^43.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@vitest/coverage-v8": "$@vitest/coverage-v8",
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
